generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VOLUNTEER
  ORGANISATION
  ADMIN
}

/// An account's lifecycle. A deleted account keeps its row so that other
/// people's registers, applications and credited hours stay intact; what is
/// removed is the person's identity and their way back in.
enum UserStatus {
  ACTIVE
  DEACTIVATED
  DELETED
}

enum OpportunityMode {
  PHYSICAL
  VIRTUAL
}

enum OpportunityStatus {
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CollaboratorStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum CheckInMethod {
  QR
  MANUAL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(VOLUNTEER)
  /// A square picture the browser has already resized, kept as a data URL.
  /// Small enough to live on the row; Supabase Storage is the step after.
  avatar       String?
  bio          String?
  status       UserStatus @default(ACTIVE)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  /// Goes up by one whenever the password changes, which makes every token
  /// issued before that moment stale. Checked on every request.
  tokenVersion Int       @default(0) @map("token_version")
  deactivatedAt DateTime? @map("deactivated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile              VolunteerProfile?
  createdOpportunities Opportunity[]      @relation("OpportunityCreator")
  collaborations       Collaborator[]
  applications         Application[]
  checkins             Checkin[]
  taskSubmissions      TaskSubmission[]
  portfolioEntries     PortfolioEntry[]
  notifications        Notification[]

  @@map("users")
}

model VolunteerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  skills            String[] @default([])
  interests         String[] @default([])
  availabilitySlots String[] @default([]) @map("availability_slots")
  location          String?
  sector            String?
  portfolioSlug     String   @unique @map("portfolio_slug")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteer_profiles")
}

model Opportunity {
  id                  String            @id @default(uuid())
  creatorId           String            @map("creator_id")
  title               String
  description         String            @db.Text
  mode                OpportunityMode
  location            String?
  sector              String?
  maxCapacity         Int               @map("max_capacity")
  applicationDeadline DateTime          @map("application_deadline")
  startsAt            DateTime?         @map("starts_at")
  endsAt              DateTime?         @map("ends_at")
  status              OpportunityStatus @default(PENDING_APPROVAL)
  reviewNote          String?           @map("review_note")
  reviewedAt          DateTime?         @map("reviewed_at")
  qrToken             String?           @map("qr_token")
  requiredSkills      String[]          @default([]) @map("required_skills")
  categories          String[]          @default([])
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  creator          User              @relation("OpportunityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  brief            OpportunityBrief?
  collaborators    Collaborator[]
  applications     Application[]
  checkins         Checkin[]
  taskSubmissions  TaskSubmission[]
  portfolioEntries PortfolioEntry[]

  @@map("opportunities")
}

/**
 * An optional PDF describing the work in more detail. It lives in its own
 * table rather than on the opportunity, because a megabyte of base64 on the
 * row would be read by every feed query that never needs it.
 */
model OpportunityBrief {
  id            String   @id @default(uuid())
  opportunityId String   @unique @map("opportunity_id")
  name          String
  data          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_briefs")
}

model Collaborator {
  id              String             @id @default(uuid())
  opportunityId   String             @map("opportunity_id")
  userId          String             @map("user_id")
  permissionLevel String             @default("CO_ORGANISER") @map("permission_level")
  status          CollaboratorStatus @default(INVITED)
  createdAt       DateTime           @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@map("collaborators")
}

model Application {
  id                  String            @id @default(uuid())
  opportunityId       String            @map("opportunity_id")
  volunteerId         String            @map("volunteer_id")
  motivationStatement String            @db.Text @map("motivation_statement")
  resumeUrl           String?           @map("resume_url")
  status              ApplicationStatus @default(PENDING)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, volunteerId])
  @@map("applications")
}

model Checkin {
  id            String        @id @default(uuid())
  opportunityId String        @map("opportunity_id")
  volunteerId   String        @map("volunteer_id")
  checkinTime   DateTime      @default(now()) @map("checkin_time")
  checkoutTime  DateTime?     @map("checkout_time")
  method        CheckInMethod @default(QR)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("checkins")
}

model TaskSubmission {
  id            String           @id @default(uuid())
  opportunityId String           @map("opportunity_id")
  volunteerId   String           @map("volunteer_id")
  hoursClaimed  Float            @map("hours_claimed")
  proofUrl      String           @map("proof_url")
  status        SubmissionStatus @default(PENDING)
  reviewNote    String?          @map("review_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("task_submissions")
}

model PortfolioEntry {
  id            String   @id @default(uuid())
  volunteerId   String   @map("volunteer_id")
  opportunityId String   @map("opportunity_id")
  hoursCredited Float    @map("hours_credited")
  skillsCredited String[] @default([]) @map("skills_credited")
  dateCredited  DateTime @default(now()) @map("date_credited")

  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("portfolio_entries")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}